# Copie este archivo como ".env" y complete sus datos locales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# --- Django ---
DJANGO_DEBUG=True
# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos MySQL local ---
DB_ENGINE=mysql
DB_NAME=musicpro_courier
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
