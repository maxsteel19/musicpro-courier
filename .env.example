# Copie este archivo como ".env" y complete sus datos locales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# --- Django ---
DJANGO_DEBUG=True
# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Cifrado de datos personales (RUT y teléfono de conductores) ---
# Genere una clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: si pierde o cambia esta clave, los datos ya cifrados no se podrán leer.
# Obligatoria con DJANGO_DEBUG=False; en desarrollo, si queda vacía, se deriva de SECRET_KEY.
DJANGO_CLAVE_CIFRADO=

# --- Base de datos MySQL local ---
DB_ENGINE=mysql
DB_NAME=musicpro_courier
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Bloqueo por intentos fallidos de inicio de sesión ---
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15

# --- Correo (recuperación de contraseña) ---
# En desarrollo el correo se muestra en la consola de "runserver".
# Para enviarlo de verdad, use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Music Pro Courier <no-responder@musicpro.cl>
